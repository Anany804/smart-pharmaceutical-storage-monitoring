    "name": "Create and recover offline alerts",
    "func": "const service = global.get('pharmaService');\nconst count = service.checkOffline();\nif (count > 0) node.status({ fill: 'red', shape: 'ring', text: `${count} device(s) offline` });\nelse node.status({ fill: 'green', shape: 'dot', text: 'device monitor active' });\nreturn null;\n",
