# Copy to .env. Values in this file are loaded by the Node-RED settings and API server.
PORT=1880
NODE_RED_HOST=127.0.0.1
NODE_RED_LOG_LEVEL=info
# For a non-loopback bind, generate a hash with: node-red admin hash-pw
# NODE_RED_ADMIN_USER=admin
# NODE_RED_ADMIN_HASH=$2b$...
# NODE_RED_DISABLE_EDITOR=true
API_HOST=127.0.0.1
API_PORT=3000

# Optional persistent database path; default is ./data/pharma.sqlite
# PHARMA_DB_PATH=/absolute/path/to/pharma.sqlite

# Prototype demonstration limits. Set these from the relevant medicine's labeling.
PHARMA_TEMP_MIN=15
PHARMA_TEMP_MAX=25
PHARMA_HUMIDITY_MIN=30
PHARMA_HUMIDITY_MAX=60
PHARMA_LIGHT_MAX_PERCENT=30
PHARMA_OFFLINE_AFTER_SECONDS=90
PHARMA_DEVICE_ID=PHARMA_ESP32_001

# Optional bearer token for POST /api/sensor-data. Configure the same value in
# firmware/include/config.h. Protect all externally exposed routes at the proxy too.
# PHARMA_INGEST_TOKEN=replace-with-a-long-random-secret
